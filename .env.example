# Copy to .env and fill in your own values. .env is git-ignored.
# Only needed if you use the `database` extra (forecastlib.database / dashboard).

# "sqlite" or "oracle"
db_kind=sqlite

# --- SQLite backend ---
db_path=./data/groundwater_forecast.db

# --- Oracle backend (required when db_kind=oracle) ---
db_username=
db_password=
db_dsn=
# Path to the Oracle client libraries, only if thick-client mode is needed.
#lib_dir=
